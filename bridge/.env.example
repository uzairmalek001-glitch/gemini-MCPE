# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit your real API key.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Check https://ai.google.dev/gemini-api/docs/models for the current
# list of available model names - they change over time.
GEMINI_MODEL=gemini-2.0-flash

# Port the bridge listens on. The behavior pack's default config.js
# expects http://localhost:3000 unless you change the bridge URL
# in-game with /scriptevent gemini:config.
PORT=3000

# Comma-separated list of player names allowed to use the assistant.
# Leave empty to allow everyone connected to the world.
ALLOWED_PLAYERS=
